# ============================================
# Somali AI Academy - DeepSeek v4 Configuration
# ============================================
# API Provider: DeepSeek (https://api.deepseek.com)
# Model: deepseek-chat (DeepSeek v4)
# Documentation: https://platform.deepseek.com/api-docs

# --------------------------------------------
# LLM (Large Language Model)
# --------------------------------------------
LLM_BINDING=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_HOST=https://api.deepseek.com/v1
LLM_API_VERSION=

# --------------------------------------------
# Embedding (for Knowledge Base / RAG)
# --------------------------------------------
# DeepSeek does not provide embeddings yet.
# Use OpenAI or another provider for embeddings.
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=sk-your-openai-api-key-here
EMBEDDING_HOST=https://api.openai.com/v1/embeddings
EMBEDDING_DIMENSION=

# --------------------------------------------
# Ports
# --------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=5173

# --------------------------------------------
# Web Search (Optional)
# --------------------------------------------
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=

# --------------------------------------------
# Security
# --------------------------------------------
DISABLE_SSL_VERIFY=false

# --------------------------------------------
# Chat Attachments
# --------------------------------------------
CHAT_ATTACHMENT_DIR=
